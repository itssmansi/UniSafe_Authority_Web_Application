# =========================================================
# UniSafe Authority Web — Environment Configuration Template
# Copy this file to .env and configure with your credentials.
# Never commit real secrets, API keys, or production tokens.
# =========================================================

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Flask AI Backend API URL
# Development uses relative /api proxied by Vite -> http://127.0.0.1:5000
# Production should point to the deployed Flask AI service URL
VITE_API_URL=/api

